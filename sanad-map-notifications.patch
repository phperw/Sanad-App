+import 'package:flutter/material.dart';
+import 'package:sanad/core/helper/responsive_extensions.dart';
+import 'package:sanad/core/theme/app_colors.dart';
+import 'package:sanad/core/theme/text_styles.dart';
+import 'package:solar_icons/solar_icons.dart';
+
+import '../data/models/nearby_mission.dart';
+
+class NearbyMissionCardWidget extends StatelessWidget {
+  final NearbyMission mission;
+  final bool selected;
+  final bool updating;
+  final VoidCallback onTap;
+  final VoidCallback onJoin;
+  final VoidCallback onCancel;
+
+  const NearbyMissionCardWidget({
+    super.key,
+    required this.mission,
+    required this.selected,
+    required this.updating,
+    required this.onTap,
+    required this.onJoin,
+    required this.onCancel,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final title = mission.title?.trim();
+    final place = [
+      if (mission.locationName != null &&
+          mission.locationName!.trim().isNotEmpty)
+        mission.locationName!.trim(),
+      if (mission.distanceMeters != null)
+        _distanceLabel(mission.distanceMeters!),
+    ].where((part) => part.isNotEmpty).join(' • ');
+    final when = [
+      if (mission.date != null) _dateLabel(mission.date!),
+      if (mission.startTime != null) _timeLabel(mission.startTime!),
+    ].where((part) => part.isNotEmpty).join(' • ');
+
+    return Container(
+      margin: EdgeInsets.only(bottom: 10.h(context)),
+      decoration: BoxDecoration(
+        color: selected
+            ? AppColors.primaryColor.withValues(alpha: 0.07)
+            : theme.cardColor,
+        borderRadius: BorderRadius.circular(18.r(context)),
+        border: Border.all(
+          color: selected
+              ? AppColors.primaryColor
+              : AppColors.borderThemed(context),
+          width: selected ? 1.4 : 1,
+        ),
+      ),
+      child: InkWell(
+        borderRadius: BorderRadius.circular(18.r(context)),
+        onTap: onTap,
+        child: Padding(
+          padding: EdgeInsets.symmetric(
+            horizontal: 14.w(context),
+            vertical: 13.h(context),
+          ),
+          child: Row(
+            children: [
+              Container(
+                width: 42.r(context),
+                height: 42.r(context),
+                decoration: BoxDecoration(
+                  color: AppColors.primaryColor.withValues(alpha: 0.1),
+                  borderRadius: BorderRadius.circular(13.r(context)),
+                ),
+                child: Icon(
+                  SolarIconsOutline.handHeart,
+                  color: AppColors.primaryColor,
+                  size: 22.r(context),
+                ),
+              ),
+              SizedBox(width: 11.w(context)),
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Text(
+                      title == null || title.isEmpty
+                          ? 'مهمة #${mission.id}'
+                          : title,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: TextStyles.cairoBold32Dark(context)
+                          .copyWith(fontSize: 13.sp(context)),
+                    ),
+                    if (place.isNotEmpty) ...[
+                      SizedBox(height: 3.h(context)),
+                      Row(
+                        children: [
+                          Icon(
+                            SolarIconsOutline.mapPoint,
+                            size: 14.r(context),
+                            color: AppColors.gray,
+                          ),
+                          SizedBox(width: 4.w(context)),
+                          Expanded(
+                            child: Text(
+                              place,
+                              maxLines: 1,
+                              overflow: TextOverflow.ellipsis,
+                              style: TextStyles.cairoRegular14Muted(context)
+                                  .copyWith(fontSize: 10.sp(context)),
+                            ),
+                          ),
+                        ],
+                      ),
+                    ],
+                    if (when.isNotEmpty || mission.availableSlots != null) ...[
+                      SizedBox(height: 2.h(context)),
+                      Text(
+                        [
+                          if (when.isNotEmpty) when,
+                          if (mission.availableSlots != null)
+                            'المقاعد المتاحة: ${mission.availableSlots}',
+                        ].join(' • '),
+                        maxLines: 1,
+                        overflow: TextOverflow.ellipsis,
+                        style: TextStyles.cairoRegular10Gray(context),
+                      ),
+                    ],
+                  ],
+                ),
+              ),
+              SizedBox(width: 8.w(context)),
+              _action(context),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _action(BuildContext context) {
+    final shape = RoundedRectangleBorder(
+      borderRadius: BorderRadius.circular(14.r(context)),
+    );
+    final size = Size(92.w(context), 38.h(context));
+    final textStyle = TextStyle(
+      fontFamily: 'Cairo',
+      fontSize: 11.sp(context),
+      fontWeight: FontWeight.bold,
+    );
+
+    if (updating) {
+      return SizedBox(
+        width: size.width,
+        height: size.height,
+        child: const Center(
+          child: SizedBox(
+            width: 20,
+            height: 20,
+            child: CircularProgressIndicator(strokeWidth: 2),
+          ),
+        ),
+      );
+    }
+
+    if (mission.isJoinPending) {
+      return OutlinedButton(
+        onPressed: onCancel,
+        style: OutlinedButton.styleFrom(
+          minimumSize: size,
+          padding: EdgeInsets.symmetric(horizontal: 6.w(context)),
+          shape: shape,
+          foregroundColor: AppColors.orange,
+          side: const BorderSide(color: AppColors.orange),
+          textStyle: textStyle,
+        ),
+        child: const Text('إلغاء الطلب', textAlign: TextAlign.center),
+      );
+    }
+
+    if (mission.isApproved) {
+      return Container(
+        width: size.width,
+        height: size.height,
+        alignment: Alignment.center,
+        decoration: BoxDecoration(
+          color: AppColors.primaryColor.withValues(alpha: 0.12),
+          borderRadius: BorderRadius.circular(14.r(context)),
+        ),
+        child: Text(
+          'تم قبولك',
+          style: textStyle.copyWith(color: AppColors.primaryColor),
+        ),
+      );
+    }
+
+    if (mission.availableSlots == 0) {
+      return Container(
+        width: size.width,
+        height: size.height,
+        alignment: Alignment.center,
+        decoration: BoxDecoration(
+          color: Theme.of(context).disabledColor.withValues(alpha: 0.15),
+          borderRadius: BorderRadius.circular(14.r(context)),
+        ),
+        child: Text(
+          'اكتملت المقاعد',
+          style: textStyle.copyWith(color: AppColors.gray),
+        ),
+      );
+    }
+
+    return FilledButton(
+      onPressed: onJoin,
+      style: FilledButton.styleFrom(
+        minimumSize: size,
+        padding: EdgeInsets.symmetric(horizontal: 6.w(context)),
+        shape: shape,
+        backgroundColor: AppColors.primaryColor,
+        foregroundColor: Colors.white,
+        textStyle: textStyle,
+      ),
+      child: const Text('طلب انضمام', textAlign: TextAlign.center),
+    );
+  }
+}
+
+const _months = [
+  'يناير',
+  'فبراير',
+  'مارس',
+  'أبريل',
+  'مايو',
+  'يونيو',
+  'يوليو',
+  'أغسطس',
+  'سبتمبر',
+  'أكتوبر',
+  'نوفمبر',
+  'ديسمبر',
+];
+
+String _distanceLabel(double meters) {
+  if (!meters.isFinite || meters < 0) return '';
+  if (meters < 1000) return '${meters.round()} م';
+  return '${(meters / 1000).toStringAsFixed(1)} كم';
+}
+
+String _dateLabel(String raw) {
+  final parsed = DateTime.tryParse(raw);
+  if (parsed == null) return raw;
+  return '${parsed.toLocal().day} ${_months[parsed.toLocal().month - 1]}';
+}
+
+String _timeLabel(String raw) {
+  final match = RegExp(r'(\d{1,2}):(\d{2})').firstMatch(raw);
+  if (match == null) return '';
+  return '${match.group(1)!.padLeft(2, '0')}:${match.group(2)}';
+}
