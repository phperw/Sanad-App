+import 'package:flutter/material.dart';
+import 'package:go_router/go_router.dart';
+import 'package:sanad/core/di/dependency_injection.dart';
+import 'package:sanad/core/helper/responsive_extensions.dart';
+import 'package:sanad/core/networking/api_result.dart';
+import 'package:sanad/core/routing/router.dart';
+import 'package:sanad/core/theme/app_colors.dart';
+import 'package:solar_icons/solar_icons.dart';
+
+import '../data/notifications_repository.dart';
+
+class NotificationBellButton extends StatefulWidget {
+  const NotificationBellButton({super.key});
+
+  @override
+  State<NotificationBellButton> createState() => _NotificationBellButtonState();
+}
+
+class _NotificationBellButtonState extends State<NotificationBellButton>
+    with WidgetsBindingObserver {
+  int _unreadCount = 0;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    _loadUnreadCount();
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) _loadUnreadCount();
+  }
+
+  Future<void> _loadUnreadCount() async {
+    final result = await getIt<NotificationsRepository>().getUnreadCount();
+    if (!mounted) return;
+    if (result case Success(:final data)) {
+      setState(() => _unreadCount = data);
+    }
+  }
+
+  Future<void> _openNotifications() async {
+    await context.push(AppRouter.kNotifications);
+    if (mounted) _loadUnreadCount();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Material(
+      color: AppColors.primaryColor.withValues(alpha: 0.10),
+      shape: const CircleBorder(),
+      child: InkWell(
+        customBorder: const CircleBorder(),
+        onTap: _openNotifications,
+        child: SizedBox(
+          width: 44.r(context),
+          height: 44.r(context),
+          child: Stack(
+            alignment: Alignment.center,
+            children: [
+              Icon(
+                SolarIconsOutline.bell,
+                color: AppColors.primaryColor,
+                size: 22.r(context),
+              ),
+              if (_unreadCount > 0)
+                PositionedDirectional(
+                  top: 6.r(context),
+                  end: 6.r(context),
+                  child: Container(
+                    constraints: BoxConstraints(
+                      minWidth: 16.r(context),
+                      minHeight: 16.r(context),
+                    ),
+                    padding: EdgeInsets.symmetric(horizontal: 4.r(context)),
+                    decoration: const BoxDecoration(
+                      color: AppColors.sosRed,
+                      borderRadius: BorderRadius.all(Radius.circular(10)),
+                    ),
+                    alignment: Alignment.center,
+                    child: Text(
+                      _unreadCount > 9 ? '9+' : '$_unreadCount',
+                      style: TextStyle(
+                        color: Colors.white,
+                        fontSize: 9.sp(context),
+                        fontWeight: FontWeight.bold,
+                        height: 1.2,
+                      ),
+                    ),
+                  ),
+                ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
