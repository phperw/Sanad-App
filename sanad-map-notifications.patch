+import 'package:flutter/material.dart';
+import 'package:sanad/core/helper/responsive_extensions.dart';
+import 'package:sanad/core/theme/app_colors.dart';
+import 'package:sanad/core/theme/text_styles.dart';
+import 'package:solar_icons/solar_icons.dart';
+
+class MapSearchFieldWidget extends StatefulWidget {
+  final ValueChanged<String> onChanged;
+
+  const MapSearchFieldWidget({super.key, required this.onChanged});
+
+  @override
+  State<MapSearchFieldWidget> createState() => _MapSearchFieldWidgetState();
+}
+
+class _MapSearchFieldWidgetState extends State<MapSearchFieldWidget> {
+  final TextEditingController _controller = TextEditingController();
+
+  @override
+  void dispose() {
+    _controller.dispose();
+    super.dispose();
+  }
+
+  void _clear() {
+    _controller.clear();
+    widget.onChanged('');
+    setState(() {});
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      height: 50.h(context),
+      decoration: BoxDecoration(
+        color: Theme.of(context).cardColor,
+        borderRadius: BorderRadius.circular(14.r(context)),
+        border: Border.all(color: AppColors.borderThemed(context)),
+        boxShadow: [
+          BoxShadow(
+            color: Colors.black.withValues(alpha: 0.08),
+            blurRadius: 10,
+            offset: const Offset(0, 4),
+          ),
+        ],
+      ),
+      child: TextField(
+        controller: _controller,
+        onChanged: (value) {
+          widget.onChanged(value);
+          setState(() {});
+        },
+        textDirection: TextDirection.rtl,
+        style: TextStyles.cairoRegular14Black(context),
+        decoration: InputDecoration(
+          hintText: 'ابحث عن مهام قريبة منك...',
+          hintStyle: TextStyles.cairoRegular14Muted(context),
+          prefixIcon: Icon(
+            SolarIconsOutline.magnifier,
+            size: 20.r(context),
+            color: AppColors.gray,
+          ),
+          suffixIcon: _controller.text.isEmpty
+              ? null
+              : IconButton(
+                  icon: Icon(
+                    SolarIconsOutline.closeCircle,
+                    size: 18.r(context),
+                  ),
+                  onPressed: _clear,
+                ),
+          border: InputBorder.none,
+          enabledBorder: InputBorder.none,
+          focusedBorder: InputBorder.none,
+          contentPadding: EdgeInsets.symmetric(vertical: 14.h(context)),
+        ),
+      ),
+    );
+  }
+}
