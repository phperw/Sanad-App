default_platform(:android)

platform :android do

  desc "Build APK and upload to Firebase App Distribution"
  lane :beta do
    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: "../"
    )
    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_ANDROID"],
      service_credentials_file: "fastlane/firebase-service-account.json",
      groups: "testers",
      release_notes: "Build #{ENV['GITHUB_SHA']&.slice(0, 7) || 'local'}"
    )
  end

end
